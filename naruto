
#include <iostream>
#include <string>
#include <thread>
#include <chrono>
#include <cstdlib>
using namespace std;

void delay(int ms) {
    this_thread::sleep_for(chrono::milliseconds(ms));
}

void clearScreen() {
    // ANSI terminal clear sequence
    cout << "\033[2J\033[H";
}

void chakraBar(int power) {
    cout << "Chakra: [";
    for (int i = 0; i < 20; i++) {
        if (i < power / 5)
            cout << "#";
        else
            cout << "-";
    }
    cout << "] " << power << "%\n";
}

void showNaruto() {
    cout << R"(
          .-""""-.
         /  o  o  \
        |    ^     |
        |  \___/   |
         \_______/
           /| |\
          / | | \
            / \
           /   \
        N A R U T O
)";
}

void showRasengan(int frame) {
    const string blue = "\033[1;36m";
    const string white = "\033[1;37m";
    const string reset = "\033[0m";

    cout << blue;
    cout << "\n       .  *  .  *  .\n";
    cout << "     *   .-'''-.   *\n";
    cout << "   .    /  ";
    cout << (frame % 2 ? "@@" : "##");
    cout << "  \\    .\n";
    cout << "  *   |  ###### |   *\n";
    cout << "   .   \\  #### /   .\n";
    cout << "     *  '-.__.-'  *\n";
    cout << "       *  .  *  .\n";
    cout << reset;

    cout << white;
    cout << "        RASENGAN!!\n";
    cout << reset;
}

