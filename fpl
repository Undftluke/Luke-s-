
#include <stdio.h>

int main() {
    int n, i, num, max, min, frequency = 0;
    int sum = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to find frequency: ");
    scanf("%d", &num);

    max = min = arr[0];

    for (i = 0; i < n; i++) {
        if (arr[i] > max)
            max = arr[i];

        if (arr[i] < min)
            min = arr[i];

        sum += arr[i];

        if (arr[i] == num)
            frequency++;
    }

    printf("\nmax: %d\n", max);
    printf("Min: %d\n", min);
    printf("Frequency of %d: %d\n", num, frequency);
    printf("Average: %.2f\n", (float)sum / n);

    return 0;
}
